    "gans, hist = build_scene(SEED, SCENE, save=False, verbose=True)\n",
    "fig = gan.plot_timegan_history(hist[CLS], title=f\"timegans seed{SEED} scene{SCENE} F{CLS}\")\n",
    "plt.show()\n"
