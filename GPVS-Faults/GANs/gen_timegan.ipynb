    }
   },
   "outputs": [],
   "source": [
    "def build_scene(seed, scene, save=True, verbose=True):\n",
    "    \"\"\"Train the 8 per-class TimeGANs on the CONTIGUOUS scene (BASE), then augment\n",
    "    the STANDARD random-sampled scene train (OUT_BASE) and write the augmented\n",
    "    CSVs beside it. Returns (gans, histories).\"\"\"\n",
    "    # 1) GAN training data: contiguous, time-ordered (chronology for windows)\n",
    "    df_gan = pd.read_csv(f\"{BASE}/seed{seed}/scene{scene}/train.csv\")\n",
    "\n",
    "    # 2) augmentation target: the SAME real rows every other GAN augments\n",
    "    df_target = pd.read_csv(f\"{OUT_BASE}/seed{seed}/scene{scene}/train.csv\")\n",
    "    cols, target_arr = df_target.columns, df_target.to_numpy()\n",
    "    assert len(target_arr) == REAL_N[scene], (\n",
    "        f\"target train.csv has {len(target_arr)} rows, expected {REAL_N[scene]} \"\n",
    "        f\"(seed{seed}/scene{scene}) -- fix the subsample before generating\")\n",
    "\n",
    "    # sanity: both trees should hold the same per-class budget\n",
    "    lab_g = df_gan.iloc[:, -1].astype(int).value_counts().sort_index()\n",
    "    lab_t = df_target.iloc[:, -1].astype(int).value_counts().sort_index()\n",
    "    if not lab_g.equals(lab_t):\n",
    "        print(f\"  WARNING seed{seed}/scene{scene}: per-class counts differ \"\n",
    "              f\"between contiguous and standard trees:\\n\"\n",
    "              f\"  contiguous: {lab_g.to_dict()}\\n  standard:   {lab_t.to_dict()}\")\n",
    "\n",
    "    print(f\"\\n=== TimeGAN | seed {seed} scene {scene} ===\")\n",
    "    gans, hist = gan.train_class_gans(df_gan.to_numpy(), seed=seed, device=device,\n",
    "                                  seq_len=SEQ_LEN[scene], **GAN_HP, verbose=verbose)\n",
    "\n",
    "    if save:\n",
    "        out_dir = f\"{OUT_BASE}/seed{seed}/scene{scene}\"\n",
    "        for r in RATIOS:\n",
    "            aug = gan.augment(target_arr, gans, r, seed=seed, device=device)\n",
    "            exp = int(round(REAL_N[scene] * (1.0 + r)))\n",
    "            assert len(aug) == exp, f\"ratio {r}: wrote {len(aug)} rows, expected {exp}\"\n",
    "            if r == 0.0:\n",
    "                assert np.array_equal(aug, target_arr), \"ratio-0 output must equal train.csv\"\n",
    "            out = f\"{out_dir}/train_timegans_augmented_ratio{r}.csv\"\n",
    "            pd.DataFrame(aug, columns=cols).to_csv(out, index=False)\n",
    "            print(f\"  wrote ratio {r}: {len(aug)} rows -> {out}\")\n",
    "    return gans, hist\n"
   ]
  },
